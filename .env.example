PORT=8787
PROVIDER_ORDER=azure,google,deepl

AZURE_KEY=
AZURE_REGION=southeastasia

GOOGLE_KEY=

DEEPL_KEY=35c44f56-5ff8-4fb2-b622-cebdeeea33ef:fx
DEEPL_PLAN=free

# ── 前端公開設定（會被寫進網頁，不要放機密）──
# npm run env:config（本機）或 npm run build:pages（部署）時讀取；
# GitHub Actions 部署請在 repo Settings → Variables 設定同名變數。
# 後端（proxy-server + 聲紋服務）對外的 https 網址，例如 Cloudflare Tunnel 網址
PUBLIC_PROXY_BASE_URL=
# DeepL CORS 中繼（Cloudflare Worker）網址
PUBLIC_DEEPL_RELAY_URL=https://overseas-trans-deepl-relay.pksos30066.workers.dev
# 以下選填：true / false（預設有後端網址時為 true）
PUBLIC_USE_PROXY=
PUBLIC_AUTO_SPEAKER=
